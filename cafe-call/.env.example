# 이 파일을 .env 로 복사한 뒤 값을 채워 넣으세요.
# cp .env.example .env

# ─── 기본 ────────────────────────────────────────────────
STORE_NAME=와이프 카페
PORT=3000

# 직원 화면 로그인 PIN. 반드시 바꾸세요.
STAFF_PIN=1234

# ─── 개인정보 ────────────────────────────────────────────
# 알림 발송 후 이 시간(분)이 지나면 전화번호를 자동으로 지웁니다.
# 픽업(수령 완료)을 누르면 시간과 무관하게 즉시 삭제됩니다.
PURGE_AFTER_MINUTES=120

# ─── 알림 발송 ───────────────────────────────────────────
# console = 실제로 보내지 않고 터미널에만 출력 (계약 전 테스트용)
# solapi  = 솔라피로 실제 발송
NOTIFY_PROVIDER=console

# alimtalk = 카카오 알림톡, sms = 문자만
NOTIFY_MODE=alimtalk

# 알림톡 실패(카톡 미사용자 등) 시 문자로 자동 대체 발송할지 여부
SMS_FALLBACK=true

# 솔라피에 등록한 발신번호 (매장 전화번호). 사전 등록이 필요합니다.
SENDER_PHONE=

# ─── 솔라피 (NOTIFY_PROVIDER=solapi 일 때) ────────────────
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 카카오 비즈니스 채널 ID (솔라피 콘솔에서 채널 연동 후 발급)
SOLAPI_PF_ID=
# 심사 통과한 알림톡 템플릿 ID
SOLAPI_TEMPLATE_ID=

# 템플릿에 등록한 변수 이름. 아래 템플릿 그대로 등록했다면 손댈 필요 없습니다.
# TEMPLATE_VAR_STORE=#{매장명}
# TEMPLATE_VAR_TICKET=#{대기번호}

# ─── 영업일 ──────────────────────────────────────────────
# 대기번호가 1번으로 초기화되는 시각(시). 새벽 4시 기준.
DAY_ROLLOVER_HOUR=4
# 한국 시간 = UTC+9 = 540분
TZ_OFFSET_MINUTES=540
